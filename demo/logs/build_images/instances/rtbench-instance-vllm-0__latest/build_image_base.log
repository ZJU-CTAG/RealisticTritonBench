    /opt/miniconda3/envs/testbed/bin/python /workspace/replace_funcs.py \
        --repo /workspace/vllm-project/vllm \
        --base_commit 6afc0ffaf61b49599dec25c30b28596a390ad2d9 \
        --head_commit d91fceb3bbf3866689c616ffbc3feaa043db1cdd \
        --pull_number 29720 \
        --specs /workspace/specs.json && \
    /opt/miniconda3/envs/testbed/bin/pip install -v -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple -e .

